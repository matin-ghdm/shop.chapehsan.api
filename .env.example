DB_SSL=false

JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Zibal payment gateway
ZIBAL_MERCHANT=zibal
ZIBAL_CALLBACK_URL=http://localhost:3001/api/payments/zibal/callback
