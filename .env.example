PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=chapehsan
DB_USER=postgres
DB_PASSWORD=

# Or use a full URL instead of DB_* above:
# DATABASE_URL=postgresql://user:pass@host:5432/chapehsan

# true only if your Postgres requires SSL (e.g. Render/Neon/Supabase)
DB_SSL=false

JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Zibal payment gateway
ZIBAL_MERCHANT=zibal
ZIBAL_CALLBACK_URL=http://localhost:3001/api/payments/zibal/callback

# SMS.ir OTP (Verify API)
SMSIR_API_KEY=
SMSIR_OTP_TEMPLATE_ID=960270
SMSIR_OTP_PARAM=CODE

# Telegram support bot (create a bot with @BotFather)
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram numeric user IDs; add more IDs here as needed.
TELEGRAM_ADMIN_IDS=
